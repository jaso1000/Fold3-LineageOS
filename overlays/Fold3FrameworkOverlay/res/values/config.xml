<?xml version="1.0" encoding="utf-8"?>
<!-- Fold3 (q2q) fold configuration for the GSI. Device state ids come from Samsung's
     /vendor/etc/devicestate/device_state_configuration.xml:
     0 CLOSE, 1 TENT, 2 HALF_FOLDED, 3 OPEN, 4 DUAL, 5 REAR_DUAL -->
<resources>
    <!-- CameraService reports FOLDED to the camera HAL for these; Samsung's HAL then routes the
         front camera id to the cover sensor instead of the inner under-display one. -->
    <integer-array name="config_foldedDeviceStates">
        <item>0</item>
    </integer-array>
    <integer-array name="config_halfFoldedDeviceStates">
        <item>1</item>
        <item>2</item>
    </integer-array>
    <integer-array name="config_openDeviceStates">
        <item>3</item>
    </integer-array>

    <!-- Jetpack WindowManager FoldingFeature (Flex mode in apps): state:posture,
         posture 1 = closed, 2 = half opened, 3 = opened -->
    <string-array name="config_device_state_postures">
        <item>0:1</item>
        <item>1:2</item>
        <item>2:2</item>
        <item>3:3</item>
    </string-array>
    <!-- Hinge on the inner 1768x2208 panel, vertical at the middle. This is a plain string in
         AOSP (not a string-array); a type mismatch makes the RRO entry silently not apply. -->
    <string name="config_display_features" translatable="false">fold-[884,0,884,2208]</string>

    <!-- Auto-brightness: the GSI already carries Samsung SM8350's curve (config_autoBrightnessLevels,
         config_autoBrightnessDisplayValuesNits, config_screenBrightnessNits/Backlight, same as the
         LineageOS samsung-sm8350 device tree) but leaves the feature switched off. -->
    <bool name="config_automatic_brightness_available">true</bool>

    <!-- Show "Double tap to wake"; fold3-fold-config's service.sh applies it to both touch
         panels via the sec_input "aot_enable" command (the driver then sends KEY_WAKEUP). -->
    <bool name="config_supportDoubleTapWake">true</bool>

    <!-- Always-on display: the GSI already points config_dozeComponent at SystemUI's DozeService
         but marks AOD unavailable. Values as in LineageOS samsung-sm8350. -->
    <bool name="config_dozeAlwaysOnDisplayAvailable">true</bool>
    <bool name="config_dozeAfterScreenOffByDefault">true</bool>
    <!-- AOD brightness. The GSI default (1/255, 0.0) puts the inner panel at 2/510, almost
         invisible. ~15% is close to Samsung's AOD level. Keep in sync with DOZE in service.sh. -->
    <integer name="config_screenBrightnessDoze">38</integer>
    <item name="config_screenBrightnessDozeFloat" format="float" type="dimen">0.15</item>

    <!-- Adaptive refresh rate. The framework default (default 60, peak 0) adds a 60 Hz render cap
         that the peak-refresh setting can't lift (the max is min(default, peak)), so the panel
         never went above 60 Hz unless "minimum refresh rate" was forced to 120. Like Pixels: no
         default cap, peak 120; SurfaceFlinger then picks 48-120 Hz from content and touch. -->
    <integer name="config_defaultRefreshRate">0</integer>
    <integer name="config_defaultPeakRefreshRate">120</integer>
</resources>

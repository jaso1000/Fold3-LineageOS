From e36da2d28461ccaa3865c78fabbf965dfcd7a83f Mon Sep 17 00:00:00 2001
From: Jason Walker <59085866+jaso1000@users.noreply.github.com>
Date: Thu, 24 Sep 2026 20:55:20 +1000
Subject: [PATCH 3/7] Audio jitter headroom + all AMR modes, RFC 4733 DTMF, fix
 periodic re-register alarm

- Playback: ~200 ms AudioTrack buffer pre-filled with 100 ms silence (LTE delivers RTP
  in bursts), accept AMR-NB FT 0..7 with the real Q bit, drain all decoder output
- DTMF: start/stop/sendDtmf queue digits; encode thread sends RFC 4733 telephone-event
  packets (100 ms + 3x end) in place of voice frames, sharing seq/SSRC
- Periodic REGISTER alarm used an implicit broadcast that never reaches the
  RECEIVER_NOT_EXPORTED receiver outside android.uid.system: make it explicit, 30 min

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 app/src/main/java/me/phh/ims/PhhImsService.kt | 11 ++-
 .../main/java/me/phh/ims/PhhMmTelFeature.kt   | 25 ++++++
 app/src/main/java/me/phh/sip/SipHandler.kt    | 78 +++++++++++++++++--
 3 files changed, 102 insertions(+), 12 deletions(-)

diff --git a/app/src/main/java/me/phh/ims/PhhImsService.kt b/app/src/main/java/me/phh/ims/PhhImsService.kt
index 8fea1d6..e61571b 100644
--- a/app/src/main/java/me/phh/ims/PhhImsService.kt
+++ b/app/src/main/java/me/phh/ims/PhhImsService.kt
@@ -35,14 +35,17 @@ class PhhImsService : ImsService() {
     }
     fun armPeriodicRegisterAlarm() {
         val alarmManager = this.getSystemService(Context.ALARM_SERVICE) as AlarmManager
-        val intent = Intent(receiver.ALARM_PERIODIC_REGISTER)
+        // Must be explicit: implicit broadcasts don't reach a RECEIVER_NOT_EXPORTED receiver
+        // (only worked before because the app ran as android.uid.system), and without the
+        // periodic REGISTER the registration lapses after the network's 1 h expiry.
+        val intent = Intent(receiver.ALARM_PERIODIC_REGISTER).setPackage(packageName)
         val pendingIntent =
             PendingIntent.getBroadcast(this, 0, intent, PendingIntent.FLAG_IMMUTABLE)
-        // We want recurring 3000s but recurring alarms don't wake up from
-        // doze: alarm will re-arm itself.
+        // Re-register every 30 min (networks commonly grant 3600 s). Recurring alarms don't
+        // wake up from doze, so the alarm re-arms itself.
         alarmManager.setAndAllowWhileIdle(
             AlarmManager.ELAPSED_REALTIME_WAKEUP,
-            SystemClock.elapsedRealtime() + 3_000_000,
+            SystemClock.elapsedRealtime() + 1_800_000,
             pendingIntent
         )
         Rlog.d(TAG, "Alarm set")

+    // Hang up an established outgoing call: send BYE (through the same Route set as the INVITE)
+    // and stop RTP. Doesn't go through onCancelledCall, which reports on the incoming-call listener.
+    fun hangupOutgoingCall() {
+        val call = currentCall
+        callStopped.set(true)
+        if (call == null) return
+        thread {
+            val toHeader = call.callHeaders["to"]?.get(0) ?: return@thread
+            val target = toHeader.substringAfter("<").substringBefore(">")
+            val msg =
+                SipRequest(
+                    SipMethod.BYE,
+                    target,
+                    call.callHeaders - "content-type" - "expires" - "session-expires" - "min-se"
+                )
+            Rlog.d(TAG, "Sending $msg")
+            synchronized(socket.gWriter()) { socket.gWriter().write(msg.toByteArray()) }
+        }
+    }
+
     fun terminateCall() {
         // IDK what packet do we send, but at least we're close rtp
         currentCall?.imsMediaSession?.let { imsMediaManager.closeSession(it) }

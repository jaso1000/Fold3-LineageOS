 app/src/main/AndroidManifest.xml              | 11 +++-
 .../main/java/me/phh/ims/PhhMmTelFeature.kt   | 11 ++++
 app/src/main/java/me/phh/sip/SipHandler.kt    | 57 +++++++++++++++++--
 4 files changed, 73 insertions(+), 13 deletions(-)


+                if (nRead <= 0) { diagShort++; Rlog.w(TAG, "Uplink: AudioRecord.read returned $nRead"); Thread.sleep(20); continue }
+                // RNNoise is a 48 kHz model; fed our 8 kHz audio it classifies speech as noise and
+                // outputs pure silence (measured: post-rnnoise rms 0 while talking). Bypass it.
+                // Capture level on this path is very low (speech ~60-110 rms of 32767), so apply a
+                // simple AGC: steer each chunk toward ~2500 rms, gain capped at 32x (+30 dB) so
+                // silence isn't pumped up into hiss, fast to back off / slow to rise, hard clip.
+                val chunkRms = rms(buffer, nRead)
+                val wanted = if (chunkRms > 8) minOf(32.0, 2500.0 / chunkRms) else agcGain
+                agcGain = if (wanted < agcGain) agcGain * 0.5 + wanted * 0.5 else agcGain * 0.9 + wanted * 0.1
+                var j = 0
+                while (j + 1 < nRead) {

+                    val g = (v * agcGain).toInt().coerceIn(-32768, 32767)
+                    bufferPostRnnoise[j] = (g and 0xff).toByte()
+                    bufferPostRnnoise[j + 1] = ((g shr 8) and 0xff).toByte()

// Fold3 ROM additions. Overlay sources and the Floss IMS source are copied in by rom/apply.sh
// from overlays/ and floss-ims/ (Floss is built from source: module PhhIms in floss-ims/).

runtime_resource_overlay {
    name: "Fold3FrameworkOverlay",
    product_specific: true,
    sdk_version: "current",
    manifest: "overlays/Fold3FrameworkOverlay/AndroidManifest.xml",
    resource_dirs: ["overlays/Fold3FrameworkOverlay/res"],
}

runtime_resource_overlay {
    name: "Fold3ApertureOverlay",
    product_specific: true,
    sdk_version: "current",
    manifest: "overlays/Fold3ApertureOverlay/AndroidManifest.xml",
    resource_dirs: ["overlays/Fold3ApertureOverlay/res"],
}

runtime_resource_overlay {
    name: "Fold3LineageOverlay",
    product_specific: true,
    sdk_version: "current",
    manifest: "overlays/Fold3LineageOverlay/AndroidManifest.xml",
    resource_dirs: ["overlays/Fold3LineageOverlay/res"],
}

runtime_resource_overlay {
    name: "Fold3SystemUIOverlay",
    product_specific: true,
    sdk_version: "current",
    manifest: "overlays/Fold3SystemUIOverlay/AndroidManifest.xml",
    resource_dirs: ["overlays/Fold3SystemUIOverlay/res"],
}

// Dolby Atmos Quick Settings tile (Samsung's DAX3 effect on the global output mix).
android_app {
    name: "Fold3Dolby",
    srcs: ["Fold3Dolby/src/**/*.java"],
    resource_dirs: ["Fold3Dolby/res"],
    manifest: "Fold3Dolby/AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
}

<?xml version="1.0" encoding="utf-8"?>
<!-- Dolby Atmos on/off for the Fold3: holds Samsung's Dolby effect (DAX3, vendor libswdap) on the
     global output mix, like One UI's Sound quality and effects > Dolby Atmos. Quick Settings tile. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.fold3.dolby">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".DolbyApp"
        android:label="@string/dolby_atmos"
        android:persistent="true"
        android:directBootAware="true"
        android:defaultToDeviceProtectedStorage="true"
        android:allowBackup="false">

        <service
            android:name=".DolbyTileService"
            android:exported="true"
            android:icon="@drawable/ic_dolby"
            android:label="@string/dolby_atmos"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>

# Firmware extracts and build artifacts — large binaries, proprietary, don't belong in git
build/
*.img
*.img.lz4
*.tar.md5
*.zip

# Built Magisk modules (contain patched GSI binaries; rebuild with scripts/)
magisk/
# Built by scripts/make-floss-module.sh
magisk-src/fold3-floss-ims/system/priv-app/
# Built overlay APKs (rebuild from overlays/)
magisk-src/fold3-fold-config/system/product/overlay/*.apk
overlays/*/build/
magisk-src/fold3-fingerprint-fix/*.dex

# Committed prebuilt module zips (see prebuilt/README.md)
!prebuilt/*.zip
